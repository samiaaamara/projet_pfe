@startuml Sprint1_Classes
title Diagramme de Classes — Sprint 1

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam backgroundColor White
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam classAttributeFontColor Black
skinparam classFontColor Black
skinparam classAttributeIconSize 0

class User {
    - id : int
    - nom : string
    - email : string
    - mot_de_passe : string
    - role : enum {admin, formateur, candidat, externe}
    - created_at : datetime
    --
    + login(email, mdp) : Token
    + register(data) : User
    + resetPasswordRequest(email) : void
    + resetPassword(token, nouveau_mdp) : void
}

class CandidatISET {
    - type_candidat : enum {etudiant, enseignant}
    - specialite : string
    - niveau : string
    - cin : string
    - telephone : string
    - date_naissance : date
    --
    + getProfil() : CandidatISET
}

class Formateur {
    - specialite : string
    - telephone : string
    --
    + getProfil() : Formateur
    + isDisponible() : boolean
}

class Externe {
    - telephone : string
    - entreprise : string
    - cin : string
    - date_naissance : date
    - specialite : string
    --
    + getProfil() : Externe
}

class Admin {
    --
    + getUsers() : User[]
    + deleteUser(id) : void
    + createFormateur(data) : Formateur
    + updateFormateur(id, data) : void
    + deleteFormateur(id) : void
    + getDashboardStats() : Stats
}

class PasswordReset {
    - id : int
    - email : string
    - token : string
    - expires_at : datetime
    --
    + isExpired() : boolean
    + invalidate() : void
}

CandidatISET --|> User
Formateur    --|> User
Externe      --|> User
Admin        --|> User

User "1" -- "0..1" PasswordReset : demande reset
Admin "1" -- "0..*" Formateur : gère

@enduml
