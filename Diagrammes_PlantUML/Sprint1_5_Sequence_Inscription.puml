@startuml Sprint1_Sequence_Inscription
title Diagramme de Séquence — Inscription

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam backgroundColor White
skinparam sequenceArrowThickness 1
skinparam sequenceMessageAlign left
skinparam sequenceBoxBackgroundColor White
skinparam sequenceBoxBorderColor Black
skinparam participantBackgroundColor White
skinparam participantBorderColor Black
skinparam actorBackgroundColor White
skinparam actorBorderColor Black
skinparam databaseBackgroundColor White
skinparam databaseBorderColor Black

actor "Utilisateur\n(Candidat / Externe)" as User
participant "Interface" as UI
participant "Système" as SYS
database "Base de données" as DB

User -> UI: Choisit son rôle (candidat ou externe)
UI --> User: Affiche le formulaire adapté
User -> UI: Remplit et soumet le formulaire
UI -> SYS: Envoie les informations
SYS -> SYS: Vérifie que tous les champs\nsont correctement remplis

alt Champs invalides
    SYS --> UI: Affiche les erreurs par champ
    UI --> User: Retour au formulaire
else Champs valides
    SYS -> DB: Vérifie si l'email existe déjà
    DB --> SYS: Résultat

    alt Email déjà utilisé
        SYS --> UI: "Email déjà utilisé"
        UI --> User: Affiche le message d'erreur
    else Email disponible
        opt Rôle = Candidat
            SYS -> DB: Vérifie si le CIN existe déjà
            DB --> SYS: Résultat

            alt CIN déjà enregistré
                SYS --> UI: "CIN déjà enregistré"
                UI --> User: Affiche le message d'erreur
            end
        end

        SYS -> SYS: Sécurise le mot de passe (bcrypt)
        SYS -> DB: Enregistre le compte\net le profil utilisateur
        DB --> SYS: Compte créé
        SYS --> UI: Inscription réussie
        UI --> User: Redirige vers la page de connexion
    end
end

@enduml
