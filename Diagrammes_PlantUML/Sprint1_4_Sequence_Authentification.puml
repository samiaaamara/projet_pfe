@startuml Sprint1_Sequence_Authentification
title Diagramme de Séquence — Authentification

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam backgroundColor White
skinparam sequenceArrowThickness 1
skinparam sequenceMessageAlign left
skinparam sequenceBoxBackgroundColor White
skinparam sequenceBoxBorderColor Black
skinparam participantBackgroundColor White
skinparam participantBorderColor Black
skinparam actorBackgroundColor White
skinparam actorBorderColor Black
skinparam databaseBackgroundColor White
skinparam databaseBorderColor Black
skinparam noteBackgroundColor White
skinparam noteBorderColor Black

actor "Utilisateur" as User
participant "Interface" as UI
participant "Système" as SYS
database "Base de données" as DB

User -> UI: Saisit email et mot de passe
User -> UI: Clique sur "Se connecter"
UI -> SYS: Envoie les informations de connexion

SYS -> DB: Recherche l'utilisateur par email
DB --> SYS: Retourne le résultat

alt Utilisateur introuvable
    SYS --> UI: "Identifiants incorrects"
    UI --> User: Affiche le message d'erreur
else Utilisateur trouvé
    SYS -> SYS: Vérifie le mot de passe (bcrypt)

    alt Mot de passe incorrect
        SYS --> UI: "Identifiants incorrects"
        UI --> User: Affiche le message d'erreur
    else Mot de passe correct
        SYS -> DB: Récupère le profil utilisateur
        DB --> SYS: Profil trouvé
        SYS -> SYS: Génère le token JWT (24h)
        SYS --> UI: Connexion réussie + token JWT
        UI -> UI: Redirige selon le rôle\n(candidat / formateur / externe )
        UI --> User: Affiche le tableau de bord
    end
end

@enduml
