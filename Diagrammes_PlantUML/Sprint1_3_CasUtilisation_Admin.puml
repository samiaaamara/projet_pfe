@startuml Sprint1_CasUtilisation_Admin
title Diagramme de cas d'utilisation — Administrateur

left to right direction

scale 0.7
skinparam dpi 150
skinparam actorStyle default
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 20
skinparam ranksep 25

skinparam usecase {
    BackgroundColor White
    BorderColor Black
    FontColor Black
}
skinparam actor {
    BackgroundColor White
    BorderColor Black
    FontColor Black
}

actor "Administrateur" as ADMIN

usecase "S'authentifier" as AUTH
usecase "Gérer les utilisateurs" as UC1
usecase "Consulter la liste des utilisateurs" as UC1_1
usecase "Supprimer un utilisateur" as UC1_2
usecase "Gérer les formateurs" as UC2
usecase "Créer un compte formateur" as UC2_1
usecase "Modifier un compte formateur" as UC2_2
usecase "Supprimer un formateur" as UC2_3
usecase "Consulter la disponibilité des formateurs" as UC2_4
usecase "Consulter le tableau de bord statistique" as UC3
usecase "Consulter le nombre de candidats et formateurs" as UC3_1
usecase "Consulter le nombre de formations publiées" as UC3_2
usecase "Consulter les inscriptions en attente" as UC3_3

ADMIN -- UC1
ADMIN -- UC2
ADMIN -- UC3

UC1 ..> AUTH : <<include>>
UC2 ..> AUTH : <<include>>
UC3 ..> AUTH : <<include>>

UC1_1 ..> UC1 : <<extend>>
UC1_2 ..> UC1 : <<extend>>
UC2_1 ..> UC2 : <<extend>>
UC2_2 ..> UC2 : <<extend>>
UC2_3 ..> UC2 : <<extend>>
UC2_4 ..> UC2 : <<extend>>
UC3_1 ..> UC3 : <<extend>>
UC3_2 ..> UC3 : <<extend>>
UC3_3 ..> UC3 : <<extend>>

@enduml
